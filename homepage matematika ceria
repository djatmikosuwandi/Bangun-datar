<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Belajar Bangun Datar Seru!</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Quicksand:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background-color: #f0f9ff;
            color: #334155;
            overflow-x: hidden;
        }
        h1, h2 {
            font-family: 'Fredoka One', cursive;
        }
        .card-btn {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card-btn:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }
        .floating {
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
            100% { transform: translateY(0px); }
        }
        .bg-pattern {
            background-color: #f0f9ff;
            background-image:  radial-gradient(#bae6fd 1px, transparent 1px);
            background-size: 30px 30px;
        }
    </style>
</head>
<body class="bg-pattern min-h-screen">

    <!-- Header Section -->
    <header class="pt-10 pb-6 text-center px-4">
        <div class="inline-block bg-yellow-300 rounded-full px-6 py-2 mb-4 shadow-sm">
            <span class="text-yellow-800 font-bold">✨ Ayo Belajar Bareng! ✨</span>
        </div>
        <h1 class="text-4xl md:text-6xl text-blue-600 mb-4 tracking-wide">
            Belajar Bangun Datar dengan Seru!
        </h1>
        <h2 class="text-xl md:text-2xl text-green-600 font-semibold max-w-2xl mx-auto leading-relaxed">
            Mari belajar persegi dan persegi panjang dengan cara menyenangkan bersama teman dan teknologi!
        </h2>
    </header>

    <!-- Intro Section -->
    <main class="max-w-5xl mx-auto px-6 pb-20">
        <section class="bg-white rounded-3xl p-8 shadow-xl border-4 border-blue-100 mb-12 relative overflow-hidden">
            <!-- Decorative Illustrations -->
            <div class="absolute -top-4 -right-4 opacity-20 floating">
                 <svg width="100" height="100" viewBox="0 0 24 24" fill="#3b82f6"><path d="M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2v14h16V5H4z"/></svg>
            </div>

            <div class="flex flex-col md:flex-row items-center gap-8">
                <div class="flex-1">
                    <p class="text-lg md:text-xl leading-relaxed text-gray-700">
                        Tahukah kamu? Bangun datar adalah bentuk-bentuk keren yang ada di sekitar kita! 
                        Lihat saja <strong>lantai kelas, buku,</strong> dan <strong>papan tulis</strong> kita. 
                        Di sini, kita akan belajar lewat proyek seru, diskusi asyik, dan ditemani oleh 
                        <strong>Generative AI</strong> sebagai teman belajar pintarmu!
                    </p>
                </div>
                <div class="hidden md:block w-48 h-48 bg-yellow-100 rounded-2xl flex items-center justify-center p-4">
                    <!-- Simple Cartoon Book/Pencil Placeholder -->
                    <svg viewBox="0 0 24 24" class="w-full h-full text-yellow-500" fill="currentColor">
                        <path d="M16.84 2.73c-.39 0-.77.15-1.06.44L3.44 15.51c-.59.59-.59 1.54 0 2.12l2.93 2.93c.59.59 1.54.59 2.12 0L20.83 8.22c.59-.59.59-1.54 0-2.12l-2.93-2.93c-.29-.29-.67-.44-1.06-.44zM16.84 4.14l2.93 2.93L18.35 8.5 15.42 5.57l1.42-1.43zM14 6.99l2.93 2.93L7.31 19.53l-2.93-2.93L14 6.99z"/>
                    </svg>
                </div>
            </div>
        </section>

        <!-- Navigation Buttons -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <!-- Button 1: AI -->
            <button onclick="console.log('Navigasi ke AI')" class="card-btn group text-left bg-gradient-to-br from-blue-400 to-blue-600 p-6 rounded-3xl shadow-lg text-white col-span-1 md:col-span-2 lg:col-span-1">
                <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">🤖</div>
                <h3 class="text-2xl font-bold mb-2">Generative AI</h3>
                <p class="text-blue-50 opacity-90">Kenalan dengan AI yang akan membantu kita belajar, bertanya, dan memahami pelajaran.</p>
                <div class="mt-4 inline-block bg-white text-blue-600 px-4 py-1 rounded-full text-sm font-bold uppercase">Ayo Coba!</div>
            </button>

            <!-- Button 2: Pertemuan 1 -->
            <button onclick="console.log('Navigasi ke Pertemuan 1')" class="card-btn group text-left bg-white p-6 rounded-3xl shadow-lg border-b-8 border-green-400">
                <div class="text-4xl mb-4 group-hover:rotate-12 transition-transform">📐</div>
                <h3 class="text-2xl font-bold text-green-600 mb-2">Pertemuan 1</h3>
                <p class="text-gray-600">Mengenal bangun datar dan ciri-cirinya.</p>
            </button>

            <!-- Button 3: Pertemuan 2 -->
            <button onclick="console.log('Navigasi ke Pertemuan 2')" class="card-btn group text-left bg-white p-6 rounded-3xl shadow-lg border-b-8 border-yellow-400">
                <div class="text-4xl mb-4 group-hover:rotate-12 transition-transform">📏</div>
                <h3 class="text-2xl font-bold text-yellow-600 mb-2">Pertemuan 2</h3>
                <p class="text-gray-600">Belajar menghitung luas persegi dan persegi panjang.</p>
            </button>

            <!-- Button 4: Pertemuan 3 -->
            <button onclick="console.log('Navigasi ke Pertemuan 3')" class="card-btn group text-left bg-white p-6 rounded-3xl shadow-lg border-b-8 border-orange-400">
                <div class="text-4xl mb-4 group-hover:rotate-12 transition-transform">🧮</div>
                <h3 class="text-2xl font-bold text-orange-600 mb-2">Pertemuan 3</h3>
                <p class="text-gray-600">Belajar menghitung keliling dan membedakannya dengan luas.</p>
            </button>

            <!-- Button 5: Pertemuan 4 -->
            <button onclick="console.log('Navigasi ke Pertemuan 4')" class="card-btn group text-left bg-white p-6 rounded-3xl shadow-lg border-b-8 border-purple-400 lg:col-span-2">
                <div class="flex flex-col md:flex-row md:items-center gap-4">
                    <div class="text-4xl group-hover:scale-125 transition-transform">🏫</div>
                    <div>
                        <h3 class="text-2xl font-bold text-purple-600 mb-2">Pertemuan 4</h3>
                        <p class="text-gray-600">Membuat dan mempresentasikan proyek ruang kelas impian.</p>
                    </div>
                </div>
            </button>

        </div>

        <!-- Motivation Footer -->
        <footer class="mt-20 text-center">
            <div class="bg-green-100 inline-block px-10 py-6 rounded-full border-2 border-dashed border-green-400">
                <p class="text-2xl text-green-700 font-bold italic">
                    "Belajar matematika itu mudah dan menyenangkan jika kita belajar bersama!"
                </p>
            </div>
            
            <div class="mt-12 flex justify-center gap-8 opacity-40">
                <div class="w-12 h-12 bg-blue-300 rounded-full"></div>
                <div class="w-12 h-12 bg-yellow-300 rounded-md"></div>
                <div class="w-12 h-12 bg-green-300 rounded-lg"></div>
            </div>
        </footer>
    </main>

</body>
</html>
